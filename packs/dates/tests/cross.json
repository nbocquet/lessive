{
  "cases": [
    {
      "id": "plage-courriel-ip",
      "language": "fr",
      "text": "😀 du 7 au 11 octobre inclus ; probe@example.org ; 192.0.2.1",
      "expectAll": [
        {
          "type": "DATE",
          "value": "du 7 au 11 octobre"
        },
        {
          "type": "EMAIL",
          "value": "probe@example.org"
        },
        {
          "type": "IP_ADDRESS",
          "value": "192.0.2.1"
        }
      ]
    },
    {
      "id": "plage-et-date-simple",
      "language": "fr",
      "text": "Les 23 et 24 novembre 2027 ; le 12.03.2027.",
      "expectAll": [
        {
          "type": "DATE",
          "value": "Les 23 et 24 novembre 2027"
        },
        {
          "type": "DATE",
          "value": "12.03.2027"
        }
      ]
    },
    {
      "id": "timestamp-log-cross",
      "language": "fr",
      "text": "😀 192.0.2.1 [21/Nov/2026:08:14:02 +0100] test@example.org HTTP/1.1 Chrome/131.0 200 5123",
      "expectAll": [
        {
          "type": "IP_ADDRESS",
          "value": "192.0.2.1"
        },
        {
          "type": "DATE",
          "value": "21/Nov/2026:08:14:02 +0100"
        },
        {
          "type": "EMAIL",
          "value": "test@example.org"
        }
      ]
    },
    {
      "id": "option-temporelle-toutes-regles",
      "language": "fr",
      "enableRules": [
        "dates/fr-time",
        "dates/fr-time-range",
        "dates/fr-relative",
        "dates/fr-relative-time-range",
        "dates/fr-relative-time",
        "dates/fr-month-year"
      ],
      "text": "Contact : test@example.org, mardi prochain entre 14 h et 16 h ; en poste depuis septembre 2022 ; demain matin. Référence REF-2022, 42 pièces.",
      "expectAll": [
        {
          "type": "EMAIL",
          "value": "test@example.org"
        },
        {
          "type": "DATE",
          "value": "mardi prochain entre 14 h et 16 h"
        },
        {
          "type": "DATE",
          "value": "septembre 2022"
        },
        {
          "type": "DATE",
          "value": "demain matin"
        }
      ]
    }
  ]
}
