{
  "rules": [
    {
      "kind": "pattern",
      "id": "timestamp-common",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./])(?=0[1-9]|[12][0-9]|3[01]|[1-9](?![0-9]))[0-9]{1,2}/(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)/(?:19|20)[0-9]{2}:(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9] [+-](?=[01][0-9]|2[0-3])[0-9]{2}[0-5][0-9](?![\\w:+-])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage nginx / Apache Common Log Format, date, heure et fuseau inclus."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-local",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9](?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes, sans fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-utc",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9]Z(?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes et fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-offset",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9][+-](?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9](?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes et fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-local-fraction",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{1,9}(?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes, fraction de seconde, sans fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-utc-fraction",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{1,9}Z(?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes, fraction de seconde et fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-iso-offset-fraction",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./:-])(?:19|20)[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{1,9}[+-](?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9](?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage ISO 8601 avec secondes, fraction de seconde et fuseau."
    },
    {
      "kind": "pattern",
      "id": "timestamp-apache-error",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./])(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun) (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}(?=0[1-9]|[12][0-9]|3[01]|[1-9](?![0-9]))[0-9]{1,2} (?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9] (?:19|20)[0-9]{2}(?!\\w)",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage du journal d’erreurs Apache, jour de semaine et année inclus."
    },
    {
      "kind": "pattern",
      "id": "timestamp-apache-error-fraction",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./])(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun) (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}(?=0[1-9]|[12][0-9]|3[01]|[1-9](?![0-9]))[0-9]{1,2} (?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{1,6} (?:19|20)[0-9]{2}(?!\\w)",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage du journal d’erreurs Apache, jour de semaine et année inclus, avec fraction de seconde."
    },
    {
      "kind": "pattern",
      "id": "timestamp-syslog",
      "entityType": "DATE",
      "score": 0.8,
      "pattern": "(?<![\\w./])(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}(?=0[1-9]|[12][0-9]|3[01]|[1-9](?![0-9]))[0-9]{1,2} (?=[01][0-9]|2[0-3])[0-9]{2}:[0-5][0-9]:[0-5][0-9](?![\\w:+-]|\\.[0-9])",
      "flags": "i",
      "languages": "any",
      "description": "Horodatage syslog traditionnel, mois abrégé anglais, jour et heure, sans année."
    }
  ]
}
