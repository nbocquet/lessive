      "flags": "i",
      "pattern": "(?<![A-Za-z0-9+]|[0-9][ \\u00a0\\u202f.\\-])[12][0-9]{2}(?!00|1[3-9]|4[3-9])[0-9]{2}(?:2[AB]|[0-9]{2})[0-9]{6}[ \\u00a0\\u202f]?[0-9]{2}(?![0-9])",
