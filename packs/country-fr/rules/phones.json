      "pattern": "(?<![A-Za-z0-9+]|[0-9][ \\u00a0.\\-])(?:0[1-79](?:[ \\u00a0.\\-][0-9]{2}){4}|0[1-79][0-9]{8})(?![0-9])",
      "context": {
        "words": {
          "fr": ["téléphone", "tél", "portable", "mobile", "joindre", "appeler"],
          "en": ["telephone", "phone", "cell", "call", "mobile"],
          "any": ["tel", "fax", "GSM"]
        }
      },
      "description": "Numéro français à 10 chiffres 0X XX XX XX XX (espaces, points, tirets ou rien). Préfixes 01 à 07 et 09 ; les 08 (services à valeur ajoutée, numéros verts) et les numéros courts (3 à 6 chiffres) sont exclus."
    },
