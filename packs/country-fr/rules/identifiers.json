        "words": {
          "fr": [
            "sécurité sociale",
            "sécu",
            "carte vitale",
            "assuré",
            "assurée",
            "assurance maladie",
            "cpam",
            "ameli"
          ],
          "en": ["social security", "health insurance", "insured"],
          "any": ["NIR", "INSEE", "Vitale"]
        }
      },
      "description": "NIR de 15 caractères sans espaces (clé éventuellement séparée par une espace) : sexe 1 ou 2, année, mois, département dont 2A/2B, commune, ordre, clé. La clé est vérifiée par fr_nir_key : une clé fausse supprime la détection. Mois : 01-12 (naissance connue), 20-42 et 50-99 (cas spéciaux) ; 00, 13-19 et 43-49 sont refusés."
    },
